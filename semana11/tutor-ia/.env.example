# Copia este archivo como .env y llena tus valores del dashboard de Supabase
# (Project Settings > API Keys). Solo la URL y la PUBLISHABLE key.
# La key de Gemini NO va aquí: va en los secretos de la Edge Function en Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
